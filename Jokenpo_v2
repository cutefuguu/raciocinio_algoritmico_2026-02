# Refatore o programa do Joquem pô, utilizando matriz e funções.


def jokenpo(jogador1, jogador2):
    opcoes = [0, 1, 2] # 0 - pedra, 1 - papel, 2 - tesoura
    matriz = [
        [0, -1, 1],
        [1, 0, -1],
        [-1, 1, 0]
    ]
    resultado = matriz[opcoes.index(jogador1)][opcoes.index(jogador2)]
    if resultado == 1:
        print("Jogador 1 venceu!")
    elif resultado == -1:
        print("Jogador 2 venceu!")
    else:
        print("Empate!")

jogador1 = int(input("Jogador 1 escolha (0 - pedra, 1 - papel, 2 - tesoura): "))
jogador2 = int(input("Jogador 2 escolha (0 - pedra, 1 - papel, 2 - tesoura): "))
jokenpo(jogador1, jogador2)